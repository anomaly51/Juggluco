# Generate this with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JUGGLUCO_API_TOKEN=replace-with-a-random-token-at-least-32-characters-long

# Generate a different value for the read-only PWA/viewer. The browser exchanges
# it once for an HttpOnly session; it can never write glucose, meals, or insulin.
JUGGLUCO_VIEWER_TOKEN=replace-with-a-different-url-safe-token-32-to-512-characters
# Secure default: false. Set exactly true only if possession of the URL should
# be sufficient to read glucose history and its sanitized forecast without login.
JUGGLUCO_VIEWER_PUBLIC=false
JUGGLUCO_VIEWER_SESSION_DAYS=30
# Only when TLS terminates at a reverse proxy. Use its exact source IP/CIDR;
# never use 0.0.0.0/0 or ::/0.
JUGGLUCO_VIEWER_TRUSTED_PROXY_CIDRS=

# Never put this value in the Android app, Gradle files, source control, or logs.
OPENROUTER_API_KEY=replace-with-a-new-openrouter-key
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-8b-instruct
OPENROUTER_AUDIO_MODEL=openai/whisper-large-v3-turbo
# Optional ISO-639-1/BCP-47 voice hint (for example ru or ru-RU). Use auto or
# leave blank to keep provider language detection.
OPENROUTER_AUDIO_LANGUAGE=auto
OPENROUTER_MEAL_CHAT_MODEL=qwen/qwen3-vl-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90

JUGGLUCO_DATABASE_PATH=./data/juggluco.db
JUGGLUCO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver,10.0.2.2
JUGGLUCO_MAX_IMAGE_BYTES=8388608
JUGGLUCO_MAX_AUDIO_BYTES=15728640
JUGGLUCO_MEAL_CHAT_MAX_PHOTOS=24
JUGGLUCO_MEAL_CHAT_MAX_AGGREGATE_IMAGE_BYTES=33554432
JUGGLUCO_MEAL_CHAT_MAX_HISTORY_MESSAGES=40
