<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_secondary_surface_pressed" />
            <stroke android:width="@dimen/lifeprompt_outline_width" android:color="@color/modern_secondary_accent_border" />
            <corners android:radius="@dimen/lifeprompt_radius_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_secondary_surface" />
            <stroke android:width="@dimen/lifeprompt_outline_width" android:color="@color/modern_secondary_border_subtle" />
            <corners android:radius="@dimen/lifeprompt_radius_card" />
        </shape>
    </item>
</selector>
