<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="8dp" android:insetTop="5dp"
            android:insetRight="8dp" android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/lifeprompt_primary_container" />
                <corners android:radius="@dimen/lifeprompt_radius_sm" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lifeprompt_surface_container_high" />
            <corners android:radius="@dimen/lifeprompt_radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
