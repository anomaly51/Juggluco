<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1B2A21" />
            <stroke android:width="1dp" android:color="@color/modern_secondary_accent_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_secondary_surface_low" />
            <stroke android:width="1dp" android:color="@color/modern_secondary_border" android:dashWidth="5dp" android:dashGap="4dp" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
