<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lifeprompt_primary_container" />
            <stroke android:width="@dimen/lifeprompt_outline_width" android:color="@color/modern_secondary_accent_border" />
            <corners android:radius="@dimen/lifeprompt_radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_secondary_surface_low" />
            <stroke android:width="@dimen/lifeprompt_outline_width" android:color="@color/modern_secondary_border" android:dashWidth="5dp" android:dashGap="4dp" />
            <corners android:radius="@dimen/lifeprompt_radius_md" />
        </shape>
    </item>
</selector>
