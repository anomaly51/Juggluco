<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#242A2C" />
            <stroke android:width="1dp" android:color="#3A4244" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1D2325" />
            <stroke android:width="1dp" android:color="#5ACB85" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B2022" />
            <stroke android:width="1dp" android:color="#2B3133" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
