<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#16261D" />
            <stroke android:width="1dp" android:color="?attr/colorControlActivated" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A2317" />
            <stroke android:width="1dp" android:color="#D6AA5C" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#151918" />
            <stroke android:width="1dp" android:color="?attr/colorButtonStroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
