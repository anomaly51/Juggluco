<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_secondary_accent_soft" />
            <stroke android:width="@dimen/lifeprompt_outline_width" android:color="@color/modern_secondary_accent_border" />
            <corners android:radius="@dimen/lifeprompt_radius_sm" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_secondary_surface_pressed" />
            <stroke android:width="@dimen/lifeprompt_outline_width" android:color="@color/modern_secondary_border" />
            <corners android:radius="@dimen/lifeprompt_radius_sm" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_secondary_surface_low" />
            <stroke android:width="@dimen/lifeprompt_outline_width" android:color="@color/modern_secondary_border" />
            <corners android:radius="@dimen/lifeprompt_radius_sm" />
        </shape>
    </item>
</selector>
