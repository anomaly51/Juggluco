<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/modern_secondary_surface_pressed" />
            <stroke android:width="1dp" android:color="@color/modern_secondary_danger" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/modern_secondary_danger_surface" />
            <stroke android:width="1dp" android:color="@color/modern_secondary_danger_border" />
        </shape>
    </item>
</selector>
