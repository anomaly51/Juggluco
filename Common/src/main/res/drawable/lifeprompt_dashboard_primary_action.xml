<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/lifeprompt_surface_container" />
            <stroke android:width="1dp" android:color="@color/lifeprompt_outline_variant" />
            <corners android:radius="@dimen/lifeprompt_radius_xs" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lifeprompt_tertiary_container" />
            <stroke android:width="1dp" android:color="@color/lifeprompt_tertiary" />
            <corners android:radius="@dimen/lifeprompt_radius_xs" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lifeprompt_primary_container" />
            <stroke android:width="2dp" android:color="@color/lifeprompt_primary" />
            <corners android:radius="@dimen/lifeprompt_radius_xs" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lifeprompt_primary_container" />
            <stroke android:width="1dp" android:color="@color/lifeprompt_primary" />
            <corners android:radius="@dimen/lifeprompt_radius_xs" />
        </shape>
    </item>
</selector>
