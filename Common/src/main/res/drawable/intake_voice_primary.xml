<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/modern_secondary_danger_surface" />
            <stroke android:width="2dp" android:color="@color/modern_secondary_danger" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/modern_secondary_warning_surface" />
            <stroke android:width="2dp" android:color="@color/modern_secondary_warning" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/modern_secondary_accent_pressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/modern_secondary_accent" />
            <stroke android:width="1dp" android:color="@color/modern_secondary_accent_pressed" />
        </shape>
    </item>
</selector>
