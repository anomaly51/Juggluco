<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/lifeprompt_error_container" />
            <stroke android:width="2dp" android:color="@color/lifeprompt_error" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/lifeprompt_tertiary_container" />
            <stroke android:width="2dp" android:color="@color/lifeprompt_tertiary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/lifeprompt_primary_container" />
            <stroke
                android:width="@dimen/lifeprompt_outline_width"
                android:color="@color/lifeprompt_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/lifeprompt_primary" />
        </shape>
    </item>
</selector>
