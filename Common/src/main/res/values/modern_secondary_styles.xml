<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ModernSensorEmptySwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/lifeprompt_touch_target</item>
        <item name="android:paddingStart">@dimen/lifeprompt_space_md</item>
        <item name="android:paddingEnd">@dimen/lifeprompt_space_sm</item>
        <item name="android:textColor">@color/modern_secondary_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="showText">false</item>
        <item name="switchMinWidth">42dp</item>
        <item name="switchPadding">12dp</item>
        <item name="thumbTint">@color/modern_secondary_switch_thumb</item>
        <item name="trackTint">@color/modern_secondary_switch_track</item>
    </style>
</resources>
