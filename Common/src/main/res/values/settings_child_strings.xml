    <string name="fullscreen_alert_behavior_title">Always open the urgent form</string>
    <string name="fullscreen_alert_behavior_body">When Android permits it, an alert opens above other apps and the lock screen. Its alarm sound continues until you press the single red acknowledgement button. Android system access can still be revoked, and no app can override blocked hardware.</string>
    <string name="fullscreen_alert_readiness_section">Android readiness</string>
