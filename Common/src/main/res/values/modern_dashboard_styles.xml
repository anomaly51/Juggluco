<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared amber-terminal overlay. Semantic glucose roles stay separate
         from the chrome so clinical meaning never depends on amber alone. -->
    <style name="ModernDashboardThemeOverlay">
        <item name="android:windowBackground">@color/lifeprompt_background</item>
        <item name="android:colorBackground">@color/lifeprompt_background</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/lifeprompt_on_background</item>
        <item name="android:textColorSecondary">@color/lifeprompt_on_surface_variant</item>
        <item name="android:colorAccent">@color/lifeprompt_primary</item>
        <item name="android:colorControlActivated">@color/lifeprompt_primary</item>
        <item name="colorControlActivated">@color/lifeprompt_primary</item>
        <item name="colorControlNormal">@color/lifeprompt_on_surface_variant</item>
        <item name="colorButtonBackground">@color/lifeprompt_surface</item>
        <item name="colorButtonStroke">@color/lifeprompt_outline</item>
        <item name="colorButtonText">@color/lifeprompt_on_surface</item>
        <item name="buttonCornerRadius">@dimen/lifeprompt_radius_md</item>
        <item name="buttonStrokeWidth">@dimen/lifeprompt_outline_width</item>
        <item name="colorControlHighlight">@color/lifeprompt_primary_container</item>
    </style>

    <style name="ModernDashboardRangeChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/lifeprompt_touch_target</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/lifeprompt_dashboard_segmented_item</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:minWidth">@dimen/lifeprompt_touch_target</item>
        <item name="android:minHeight">@dimen/lifeprompt_touch_target</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/modern_dashboard_chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ModernDashboardNavigationItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/lifeprompt_dashboard_nav_item</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/modern_dashboard_nav_text</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:maxLines">1</item>
        <item name="android:minWidth">@dimen/lifeprompt_touch_target</item>
        <item name="android:minHeight">@dimen/lifeprompt_touch_target</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/modern_dashboard_nav_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ModernDashboardPrimaryNavigationItem" parent="ModernDashboardNavigationItem">
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/lifeprompt_dashboard_primary_action</item>
        <item name="android:drawableTint">@color/modern_dashboard_primary_action_text</item>
        <item name="android:textColor">@color/modern_dashboard_primary_action_text</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
