<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The dashboard is a product surface rather than a legacy theme preview.
         Keeping its palette stable prevents an old persisted theme from turning
         the new information hierarchy into a high-noise or low-contrast screen. -->
    <style name="ModernDashboardThemeOverlay">
        <item name="android:windowBackground">#080A0A</item>
        <item name="android:colorBackground">#080A0A</item>
        <item name="android:textColorPrimary">#F2F5F3</item>
        <item name="android:textColorSecondary">#939B97</item>
        <item name="android:colorAccent">#4ECB83</item>
        <item name="android:colorControlActivated">#4ECB83</item>
        <item name="colorControlActivated">#4ECB83</item>
        <item name="colorControlNormal">#939B97</item>
        <item name="colorButtonBackground">#151918</item>
        <item name="colorButtonStroke">#303633</item>
        <item name="colorButtonText">#F2F5F3</item>
        <item name="colorControlHighlight">#304ECB83</item>
    </style>

    <style name="ModernDashboardRangeChip">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/modern_dashboard_range_chip</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/modern_dashboard_chip_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ModernDashboardNavigationItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/modern_dashboard_nav_item</item>
        <item name="android:drawablePadding">1dp</item>
        <item name="android:drawableTint">@color/modern_dashboard_nav_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">1dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">1dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/modern_dashboard_nav_text</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
