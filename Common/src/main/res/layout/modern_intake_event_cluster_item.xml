<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/intake_event_cluster_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/intake_choice_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="88dp"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <View
        android:id="@+id/intake_event_cluster_item_accent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="14dp"
        android:background="@color/modern_secondary_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/intake_event_cluster_item_kind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/modern_secondary_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/intake_event_cluster_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/modern_secondary_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/intake_event_cluster_item_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/modern_secondary_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/intake_event_cluster_item_absorption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/modern_secondary_warning"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:padding="11dp"
        android:src="@drawable/modern_secondary_chevron" />
</LinearLayout>
