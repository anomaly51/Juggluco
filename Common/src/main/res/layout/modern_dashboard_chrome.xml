<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modern_dashboard_chrome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lifeprompt_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:importantForAccessibility="auto"
    android:theme="@style/ModernDashboardThemeOverlay">

    <LinearLayout
        android:id="@+id/modern_dashboard_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/modern_dashboard_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/lifeprompt_space_md"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/lifeprompt_space_md"
            android:paddingBottom="0dp">

            <LinearLayout
                android:id="@+id/modern_dashboard_graph_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/lifeprompt_dashboard_graph_card"
                android:clipChildren="true"
                android:clipToOutline="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/modern_dashboard_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/lifeprompt_dashboard_hero_strip"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/lifeprompt_space_md"
                    android:paddingTop="@dimen/lifeprompt_space_sm"
                    android:paddingEnd="@dimen/lifeprompt_space_md"
                    android:paddingBottom="@dimen/lifeprompt_space_sm">

                    <LinearLayout
                        android:id="@+id/modern_dashboard_hero_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/modern_dashboard_reading_column"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/modern_dashboard_hero_reading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="start|center_vertical"
                                android:importantForAccessibility="yes"
                                android:minHeight="60dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/modern_dashboard_value_row"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="start|center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/modern_dashboard_value"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="monospace"
                                        android:fontFeatureSettings="tnum"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:text="@string/dashboard_empty_value"
                                        android:textColor="@color/lifeprompt_glucose_neutral"
                                        android:textSize="58sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/modern_dashboard_trend"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="7dp"
                                        android:includeFontPadding="false"
                                        android:textColor="@color/lifeprompt_glucose_in_target"
                                        android:textSize="32sp"
                                        android:textStyle="bold"
                                        android:visibility="gone" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/modern_dashboard_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:layout_marginStart="7dp"
                                    android:layout_marginBottom="9dp"
                                    android:fontFamily="monospace"
                                    android:importantForAccessibility="no"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/lifeprompt_on_surface_variant"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/modern_dashboard_meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/modern_dashboard_range_state"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:text="@string/dashboard_state_unknown"
                                    android:textColor="@color/lifeprompt_on_surface_variant"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/modern_dashboard_freshness"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:fontFamily="monospace"
                                    android:fontFeatureSettings="tnum"
                                    android:gravity="end"
                                    android:importantForAccessibility="no"
                                    android:includeFontPadding="false"
                                    android:maxLines="2"
                                    android:text="@string/dashboard_no_current_reading"
                                    android:textColor="@color/modern_dashboard_freshness_text"
                                    android:textSize="12sp"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/modern_dashboard_graph_header"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/lifeprompt_space_sm"
                    android:paddingEnd="@dimen/lifeprompt_space_sm">

                    <TextView
                        android:id="@+id/modern_dashboard_target_range"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/dashboard_target_unavailable"
                        android:textColor="@color/lifeprompt_on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/modern_dashboard_graph_controls"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/lifeprompt_space_sm"
                    android:paddingEnd="@dimen/lifeprompt_space_sm">

                    <TextView
                        android:id="@+id/modern_dashboard_graph_hint"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="@string/dashboard_graph_hint"
                        android:visibility="gone" />

                    <HorizontalScrollView
                        android:id="@+id/modern_dashboard_range_scroller"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:clipToPadding="false"
                        android:fillViewport="true"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/modern_dashboard_ranges"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/lifeprompt_dashboard_segmented_track"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <Button android:id="@+id/modern_dashboard_range_3h" style="@style/ModernDashboardRangeChip" android:contentDescription="@string/dashboard_show_3_hours" android:text="@string/dashboard_3_hours" />
                            <Button android:id="@+id/modern_dashboard_range_6h" style="@style/ModernDashboardRangeChip" android:contentDescription="@string/dashboard_show_6_hours" android:text="@string/dashboard_6_hours" />
                            <Button android:id="@+id/modern_dashboard_range_8h" style="@style/ModernDashboardRangeChip" android:contentDescription="@string/dashboard_show_8_hours" android:text="@string/dashboard_8_hours" />
                            <Button android:id="@+id/modern_dashboard_range_12h" style="@style/ModernDashboardRangeChip" android:contentDescription="@string/dashboard_show_12_hours" android:text="@string/dashboard_12_hours" />
                            <Button android:id="@+id/modern_dashboard_range_24h" style="@style/ModernDashboardRangeChip" android:contentDescription="@string/dashboard_show_24_hours" android:text="@string/dashboard_24_hours" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/modern_dashboard_plot"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <FrameLayout
                        android:id="@+id/modern_dashboard_graph_host"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="true"
                        android:clipToPadding="true" />

                    <Button
                        android:id="@+id/modern_dashboard_now"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/lifeprompt_dashboard_tonal_action"
                        android:contentDescription="@string/now"
                        android:drawableStart="@drawable/modern_dashboard_now"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/modern_dashboard_tonal_action_text"
                        android:elevation="0dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:minWidth="72dp"
                        android:minHeight="48dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:stateListAnimator="@null"
                        android:text="@string/now"
                        android:textAllCaps="false"
                        android:textColor="@color/modern_dashboard_tonal_action_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/modern_dashboard_actions"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/lifeprompt_dashboard_nav_background"
            android:baselineAligned="false"
            android:gravity="center"
            android:importantForAccessibility="auto"
            android:orientation="horizontal">

            <Button
                android:id="@+id/modern_dashboard_add_intake"
                style="@style/ModernDashboardPrimaryNavigationItem"
                android:layout_weight="1.65"
                android:contentDescription="@string/dashboard_add_description"
                android:drawableStart="@drawable/modern_dashboard_intake"
                android:text="@string/intake_add_short" />

            <Button
                android:id="@+id/modern_dashboard_menu"
                style="@style/ModernDashboardNavigationItem"
                android:layout_weight="1"
                android:contentDescription="@string/dashboard_more_description"
                android:drawableStart="@drawable/modern_dashboard_menu"
                android:text="@string/dashboard_more" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
