<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/intake_backend_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modern_secondary_background"
    android:clickable="true"
    android:focusable="true"
    android:theme="@style/ModernDashboardThemeOverlay">

    <LinearLayout
        android:id="@+id/intake_backend_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/intake_backend_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/intake_backend_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/intake_button_secondary"
                android:contentDescription="@string/settings_back"
                android:padding="12dp"
                android:src="@drawable/baseline_arrow_back_20"
                android:tint="@color/modern_secondary_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/intake_backend_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:text="@string/intake_backend_settings_title"
                    android:textColor="@color/modern_secondary_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/intake_backend_settings_summary"
                    android:textColor="@color/modern_secondary_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/intake_backend_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/intake_backend_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/intake_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/intake_backend_url"
                    android:textColor="@color/modern_secondary_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/intake_backend_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/intake_field"
                    android:hint="@string/intake_backend_url_hint"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    android:singleLine="true"
                    android:textColor="@color/modern_secondary_text_primary"
                    android:textColorHint="@color/modern_secondary_text_muted"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/intake_backend_token"
                    android:textColor="@color/modern_secondary_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/intake_backend_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/intake_field"
                    android:hint="@string/intake_backend_token_hint"
                    android:inputType="textPassword"
                    android:maxLength="256"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    android:singleLine="true"
                    android:textColor="@color/modern_secondary_text_primary"
                    android:textColorHint="@color/modern_secondary_text_muted"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/intake_backend_test_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/intake_chip"
                    android:gravity="center_vertical"
                    android:minHeight="46dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/intake_backend_checking"
                    android:textColor="@color/modern_secondary_text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/intake_backend_test"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/intake_button_secondary"
                    android:minHeight="56dp"
                    android:stateListAnimator="@null"
                    android:text="@string/intake_backend_test"
                    android:textAllCaps="false"
                    android:textColor="@color/modern_secondary_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/intake_backend_local_help"
                    android:textColor="@color/modern_secondary_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/intake_backend_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/intake_button_primary"
            android:minHeight="56dp"
            android:stateListAnimator="@null"
            android:text="@string/intake_backend_save"
            android:textAllCaps="false"
            android:textColor="@color/modern_secondary_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
