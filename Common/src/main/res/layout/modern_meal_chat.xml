<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/intake_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modern_secondary_background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/intake_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/intake_back_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/intake_button_secondary"
                android:contentDescription="@string/intake_back"
                android:padding="12dp"
                android:rotation="180"
                android:src="@drawable/modern_secondary_chevron" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/meal_chat_title"
                    android:textColor="@color/modern_secondary_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:text="@string/meal_chat_subtitle"
                    android:textColor="@color/modern_secondary_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/intake_backend_status"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/intake_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxWidth="116dp"
                android:maxLines="2"
                android:minWidth="80dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/intake_backend_checking"
                android:textAlignment="center"
                android:textColor="@color/modern_secondary_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/meal_chat_time"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/intake_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:textColor="@color/modern_secondary_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/meal_chat_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/meal_chat_feed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/meal_chat_messages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/meal_chat_action_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/meal_chat_proposal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/intake_chat_proposal"
                    android:accessibilityLiveRegion="polite"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/meal_chat_proposal_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/intake_chat_action_saved"
                        android:textColor="@color/modern_secondary_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/meal_chat_proposal_meal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/modern_secondary_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/meal_chat_proposal_carbs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/modern_secondary_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/meal_chat_proposal_absorption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/modern_secondary_accent"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/meal_chat_proposal_confidence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/modern_secondary_text_muted"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/meal_chat_proposal_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/intake_chip"
                        android:clickable="false"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:gravity="center_vertical"
                        android:maxLines="2"
                        android:minHeight="48dp"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:text="@string/meal_chat_proposal_time_action"
                        android:textColor="@color/modern_secondary_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/meal_chat_proposal_warnings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/modern_secondary_warning"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/meal_chat_proposal_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/intake_chat_correction_hint"
                        android:textColor="@color/modern_secondary_text_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/intake_chat_action_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/meal_chat_confirm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/intake_action_undo"
                            android:maxLines="2"
                            android:minHeight="48dp"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:stateListAnimator="@null"
                            android:text="@string/intake_chat_action_delete"
                            android:textAllCaps="false"
                            android:textColor="@color/modern_secondary_danger"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <HorizontalScrollView
            android:id="@+id/meal_chat_attachment_scroll"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/meal_chat_attachments"
                android:layout_width="wrap_content"
                android:layout_height="82dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/meal_chat_safety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:contentDescription="@string/meal_chat_safety"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/meal_chat_safety_compact"
            android:textColor="@color/modern_secondary_text_muted"
            android:textSize="10sp" />

        <Button
            android:id="@+id/intake_chat_reconcile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/intake_action_undo"
            android:stateListAnimator="@null"
            android:text="@string/intake_chat_reconcile"
            android:textAllCaps="false"
            android:textColor="@color/modern_secondary_danger"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/intake_chat_inline_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="8dp"
                android:accessibilityLiveRegion="assertive"
                android:background="@drawable/intake_safety_notice"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="13dp"
                android:paddingTop="9dp"
                android:paddingEnd="13dp"
                android:paddingBottom="9dp"
                android:textColor="@color/modern_secondary_warning"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/meal_chat_voice"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/intake_voice_primary"
                android:clickable="true"
                android:contentDescription="@string/meal_chat_voice"
                android:elevation="6dp"
                android:focusable="true">

                <ProgressBar
                    android:id="@+id/meal_chat_voice_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/meal_chat_voice_icon"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/intake_mic"
                    android:tint="@color/modern_secondary_on_accent" />
            </FrameLayout>

            <TextView
                android:id="@+id/intake_chat_voice_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="7dp"
                android:text="@string/intake_chat_voice_hint"
                android:textColor="@color/modern_secondary_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/meal_chat_attach"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/intake_button_secondary"
                    android:clickable="true"
                    android:contentDescription="@string/meal_chat_attach"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/intake_add"
                        android:tint="@color/modern_secondary_text_primary" />
                </FrameLayout>

                <EditText
                    android:id="@+id/meal_chat_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/intake_chat_input"
                    android:gravity="center_vertical"
                    android:hint="@string/meal_chat_message_hint"
                    android:imeOptions="actionSend|flagNoExtractUi"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxHeight="112dp"
                    android:maxLines="4"
                    android:minHeight="50dp"
                    android:textColor="@color/modern_secondary_text_primary"
                    android:textColorHint="@color/modern_secondary_text_muted"
                    android:textSize="14sp" />

                <FrameLayout
                    android:id="@+id/meal_chat_send"
                    android:layout_width="54dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/intake_button_primary"
                    android:clickable="true"
                    android:contentDescription="@string/meal_chat_send"
                    android:focusable="true">

                    <ProgressBar
                        android:id="@+id/meal_chat_send_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/modern_secondary_on_accent"
                        android:indeterminateTintMode="src_in"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/meal_chat_send_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/intake_send"
                        android:tint="@color/modern_secondary_on_accent" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
