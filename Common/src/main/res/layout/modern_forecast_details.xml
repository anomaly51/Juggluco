<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/forecast_details_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lifeprompt_background"
    android:clickable="true"
    android:focusable="false"
    android:importantForAccessibility="no"
    android:theme="@style/ModernDashboardThemeOverlay">

    <LinearLayout
        android:id="@+id/forecast_details_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/forecast_details_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="68dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/forecast_details_close"
                android:layout_width="@dimen/lifeprompt_touch_target"
                android:layout_height="@dimen/lifeprompt_touch_target"
                android:background="@drawable/forecast_details_icon_button"
                android:contentDescription="@string/intake_close"
                android:padding="12dp"
                android:src="@drawable/intake_close"
                android:tint="@color/lifeprompt_on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/forecast_details_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:text="@string/forecast_page_title"
                    android:textColor="@color/lifeprompt_on_background"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/forecast_details_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/forecast_page_subtitle"
                    android:textColor="@color/lifeprompt_on_surface_variant"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/forecast_details_refresh_container"
                android:layout_width="@dimen/lifeprompt_touch_target"
                android:layout_height="@dimen/lifeprompt_touch_target">

                <ImageButton
                    android:id="@+id/forecast_details_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/forecast_details_icon_button"
                    android:contentDescription="@string/forecast_refresh"
                    android:padding="12dp"
                    android:src="@drawable/forecast_refresh"
                    android:tint="@color/lifeprompt_on_surface" />

                <ProgressBar
                    android:id="@+id/forecast_details_loading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/forecast_refresh_loading"
                    android:indeterminateTint="@color/lifeprompt_primary"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/forecast_details_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="@dimen/lifeprompt_phone_gutter"
            android:paddingEnd="@dimen/lifeprompt_phone_gutter"
            android:paddingBottom="@dimen/lifeprompt_space_xl"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/forecast_details_outlook_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/forecast_details_surface_card"
                    android:orientation="vertical"
                    android:padding="@dimen/lifeprompt_space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/forecast_details_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:background="@drawable/forecast_details_status_chip"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:minHeight="36dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/forecast_status_checking"
                            android:textColor="@color/lifeprompt_on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/forecast_details_generated"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:maxLines="2"
                            android:text="@string/forecast_not_generated"
                            android:textColor="@color/lifeprompt_on_surface_variant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lifeprompt_space_md"
                        android:fontFamily="monospace"
                        android:text="@string/forecast_outlook_label"
                        android:textColor="@color/lifeprompt_on_surface_variant"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/forecast_details_outlook"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="@string/forecast_outlook_waiting"
                        android:textColor="@color/lifeprompt_on_surface"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/forecast_details_outcome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/forecast_outcome_waiting"
                        android:textColor="@color/lifeprompt_on_surface_variant"
                        android:textSize="14sp" />

                    <tk.glucodata.ForecastTrajectoryView
                        android:id="@+id/forecast_details_trajectory"
                        android:layout_width="match_parent"
                        android:layout_height="196dp"
                        android:layout_marginTop="@dimen/lifeprompt_space_sm"
                        android:contentDescription="@string/forecast_chart_waiting" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lifeprompt_space_xs"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/forecast_horizon_label"
                                android:textColor="@color/lifeprompt_on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/forecast_details_horizon"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="@string/forecast_value_unavailable"
                                android:textColor="@color/lifeprompt_on_surface"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="@string/forecast_confidence_label"
                                android:textColor="@color/lifeprompt_on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/forecast_details_confidence"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:gravity="end"
                                android:text="@string/forecast_value_unavailable"
                                android:textColor="@color/lifeprompt_primary"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/forecast_details_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lifeprompt_space_sm"
                        android:background="@drawable/forecast_details_error_notice"
                        android:lineSpacingExtra="2dp"
                        android:padding="@dimen/lifeprompt_space_sm"
                        android:textColor="@color/lifeprompt_on_error_container"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/forecast_details_conditional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lifeprompt_space_sm"
                    android:background="@drawable/forecast_details_notice"
                    android:lineSpacingExtra="2dp"
                    android:padding="@dimen/lifeprompt_space_sm"
                    android:text="@string/forecast_default_notice"
                    android:textColor="@color/lifeprompt_on_tertiary_container"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/forecast_details_factors_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lifeprompt_space_sm"
                    android:background="@drawable/forecast_details_surface_card"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/forecast_details_factors_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="72dp"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="@string/forecast_factors_title"
                                android:textColor="@color/lifeprompt_on_surface"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/forecast_details_factors_summary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/forecast_factors_summary_none"
                                android:textColor="@color/lifeprompt_on_surface_variant"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/forecast_details_factors_chevron"
                            android:layout_width="40dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="›"
                            android:textColor="@color/lifeprompt_on_surface_variant"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/forecast_details_factors_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/lifeprompt_outline_variant" />

                        <LinearLayout
                            android:id="@+id/forecast_details_factors"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/forecast_details_model_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/lifeprompt_space_sm"
                    android:layout_marginBottom="@dimen/lifeprompt_space_xl"
                    android:background="@drawable/forecast_details_surface_card"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/forecast_details_model_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="72dp"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="@string/forecast_model_details_title"
                                android:textColor="@color/lifeprompt_on_surface"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/forecast_model_details_summary"
                                android:textColor="@color/lifeprompt_on_surface_variant"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/forecast_details_model_chevron"
                            android:layout_width="40dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="›"
                            android:textColor="@color/lifeprompt_on_surface_variant"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/forecast_details_model_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/lifeprompt_outline_variant" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="@string/forecast_data_title"
                            android:textColor="@color/lifeprompt_on_surface"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/forecast_details_data"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/forecast_data_empty"
                            android:textColor="@color/lifeprompt_on_surface_variant"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="monospace"
                            android:text="@string/forecast_accuracy_title"
                            android:textColor="@color/lifeprompt_on_surface"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/forecast_details_accuracy_7d"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/lifeprompt_on_surface_variant"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/forecast_details_accuracy_30d"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/lifeprompt_on_surface_variant"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="monospace"
                            android:text="@string/forecast_model_title"
                            android:textColor="@color/lifeprompt_on_surface"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/forecast_details_training"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/forecast_model_waiting"
                            android:textColor="@color/lifeprompt_on_surface_variant"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/forecast_details_version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/lifeprompt_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
