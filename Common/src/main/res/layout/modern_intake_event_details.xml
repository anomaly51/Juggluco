<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/intake_event_details_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B8000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/intake_event_details_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginStart="8dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/intake_event_sheet_background"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@color/modern_secondary_border" />

        <LinearLayout
            android:id="@+id/intake_event_details_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/intake_event_details_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="@string/intake_event_details_title_meal"
                    android:textColor="@color/modern_secondary_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/intake_event_details_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/modern_secondary_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/intake_event_details_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/intake_button_secondary"
                android:contentDescription="@string/intake_event_details_close"
                android:padding="12dp"
                android:src="@drawable/intake_close" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/intake_event_details_kind"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/intake_chip"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/modern_secondary_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/intake_event_details_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-light"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/modern_secondary_text_primary"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/intake_surface"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/intake_event_details_amount_label"
                        android:textColor="@color/modern_secondary_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/intake_event_details_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/modern_secondary_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/intake_event_details_absorption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp"
                            android:background="@color/modern_secondary_border_subtle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/carb_absorption_label"
                            android:textColor="@color/modern_secondary_text_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/intake_event_details_absorption_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/modern_secondary_accent"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/carb_absorption_note"
                            android:textColor="@color/modern_secondary_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/modern_secondary_border_subtle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/intake_event_details_type_label"
                        android:textColor="@color/modern_secondary_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/intake_event_details_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/modern_secondary_text_secondary"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/modern_secondary_border_subtle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/intake_event_details_time_label"
                        android:textColor="@color/modern_secondary_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/intake_event_details_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/modern_secondary_text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/intake_event_details_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/intake_safety_notice"
                    android:lineSpacingExtra="2dp"
                    android:padding="13dp"
                    android:textColor="@color/modern_secondary_text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/intake_event_details_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/add_record_delete_panel"
                    android:padding="13dp"
                    android:text="@string/intake_event_delete_error"
                    android:textColor="@color/modern_secondary_danger"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/intake_event_details_delete"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/add_record_danger"
                    android:contentDescription="@string/intake_event_delete_accessibility"
                    android:drawableStart="@drawable/intake_event_delete"
                    android:drawablePadding="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:text="@string/intake_event_delete"
                    android:textAllCaps="false"
                    android:textColor="@color/modern_secondary_danger"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/intake_event_delete_confirmation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/add_record_delete_panel"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/intake_event_delete_confirm_title"
                        android:textColor="@color/modern_secondary_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/intake_event_delete_confirm_message"
                        android:textColor="@color/modern_secondary_text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/intake_event_delete_cancel"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:background="@drawable/intake_button_secondary"
                            android:minHeight="48dp"
                            android:stateListAnimator="@null"
                            android:text="@string/intake_event_delete_keep"
                            android:textAllCaps="false"
                            android:textColor="@color/modern_secondary_text_primary" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1">

                            <Button
                                android:id="@+id/intake_event_delete_confirm"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/add_record_danger"
                                android:contentDescription="@string/intake_event_delete_confirm_accessibility"
                                android:minHeight="48dp"
                                android:stateListAnimator="@null"
                                android:text="@string/intake_event_delete_confirm"
                                android:textAllCaps="false"
                                android:textColor="@color/modern_secondary_danger" />

                            <ProgressBar
                                android:id="@+id/intake_event_delete_progress"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/intake_event_deleting"
                                android:indeterminateTint="@color/modern_secondary_danger"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
