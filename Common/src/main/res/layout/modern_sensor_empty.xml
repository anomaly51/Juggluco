<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20B0D0E"
    android:clickable="true"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:focusable="true"
    android:overScrollMode="ifContentScrolls"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/modern_sensor_empty_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/modern_sensor_empty_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/modern_dashboard_sensor"
            android:drawablePadding="10dp"
            android:drawableTint="@color/modern_secondary_accent"
            android:fontFamily="sans-serif-medium"
            android:text="@string/dashboard_sensor_connection"
            android:textColor="@color/modern_secondary_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/dashboard_sensor_empty_hint"
            android:textColor="@color/modern_secondary_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/modern_sensor_bluetooth_state"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/modern_sensor_empty_status"
            android:gravity="center"
            android:minWidth="120dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/modern_secondary_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/modern_secondary_switch_group"
            android:orientation="vertical"
            android:padding="4dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/modern_sensor_use_bluetooth"
                style="@style/ModernSensorEmptySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/use_bluetooth" />

            <View
                android:id="@+id/modern_sensor_stream_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@color/modern_secondary_border_subtle" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/modern_sensor_stream_history"
                style="@style/ModernSensorEmptySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/streamhistory" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/modern_sensor_help"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/modern_sensor_empty_secondary"
                android:minHeight="48dp"
                android:text="@string/helpname"
                android:textAllCaps="false"
                android:textColor="@color/modern_secondary_text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/modern_sensor_close"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/modern_sensor_empty_primary"
                android:minHeight="48dp"
                android:text="@string/closename"
                android:textAllCaps="false"
                android:textColor="@color/modern_secondary_on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</ScrollView>
