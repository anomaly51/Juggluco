<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ModernMenuTitle" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/modern_secondary_text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="ModernMenuSubtitle" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/modern_secondary_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="ModernMenuSectionTitle" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/modern_secondary_accent</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="ModernMenuAction" parent="android:style/Widget.Button">
        <item name="android:background">@drawable/modern_menu_action</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/modern_secondary_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ModernMenuTileAction" parent="ModernMenuAction">
        <item name="android:background">@drawable/modern_menu_tile</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@color/modern_secondary_accent</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ModernMenuListAction" parent="ModernMenuAction">
        <item name="android:drawableEnd">@drawable/modern_secondary_chevron</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ModernMenuCompactAction" parent="ModernMenuAction">
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ModernMenuCloseAction" parent="ModernMenuCompactAction">
        <item name="android:textColor">@color/modern_secondary_danger</item>
    </style>

    <style name="ModernMenuCloseListAction" parent="ModernMenuListAction">
        <item name="android:drawableEnd">@null</item>
        <item name="android:textColor">@color/modern_secondary_danger</item>
    </style>

    <style name="ModernMenuSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:background">@drawable/modern_menu_action</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/modern_secondary_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="showText">false</item>
        <item name="switchMinWidth">42dp</item>
        <item name="switchPadding">12dp</item>
        <item name="thumbTint">@color/modern_secondary_switch_thumb</item>
        <item name="trackTint">@color/modern_secondary_switch_track</item>
    </style>

    <style name="ModernMenuNestedSwitch" parent="ModernMenuSwitch">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:textColor">@color/modern_secondary_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
