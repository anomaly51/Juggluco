<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SensorScreenTitle" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/modern_secondary_text_primary</item>
        <item name="android:textSize">27sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="SensorScreenSubtitle" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/modern_secondary_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="SensorScreenSectionTitle" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/modern_secondary_text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SensorScreenEyebrow" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/modern_secondary_text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="SensorScreenValue" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/modern_secondary_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SensorScreenMonospaceValue" parent="SensorScreenValue">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/modern_secondary_accent</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="SensorScreenStatus" parent="android:style/Widget.TextView">
        <item name="android:background">@drawable/sensor_screen_status_enabled</item>
        <item name="android:textColor">@color/modern_secondary_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="SensorScreenSignal" parent="SensorScreenStatus">
        <item name="android:background">@drawable/sensor_screen_signal</item>
        <item name="android:textColor">@color/modern_secondary_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">30dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <style name="SensorScreenLog" parent="android:style/Widget.TextView">
        <item name="android:background">@drawable/sensor_screen_log</item>
        <item name="android:textColor">@color/modern_secondary_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:padding">10dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="SensorScreenDiagnosticTitle" parent="SensorScreenValue">
        <item name="android:textColor">@color/modern_secondary_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SensorScreenDiagnosticBody" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/modern_secondary_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="SensorScreenSuccessValue" parent="SensorScreenDiagnosticBody">
        <item name="android:textColor">@color/modern_secondary_accent</item>
    </style>

    <style name="SensorScreenFailureValue" parent="SensorScreenDiagnosticBody">
        <item name="android:textColor">@color/modern_secondary_danger</item>
    </style>

    <style name="SensorScreenCheck" parent="@style/MyCheckBoxStyle">
        <item name="android:textColor">@color/modern_secondary_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:buttonTint">@color/modern_secondary_accent</item>
    </style>

    <style name="SensorScreenSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/modern_secondary_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="showText">false</item>
        <item name="switchMinWidth">42dp</item>
        <item name="switchPadding">12dp</item>
        <item name="thumbTint">@color/modern_secondary_switch_thumb</item>
        <item name="trackTint">@color/modern_secondary_switch_track</item>
    </style>

    <style name="SensorScreenButtonBase" parent="android:style/Widget.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <style name="SensorScreenPrimaryButton" parent="SensorScreenButtonBase">
        <item name="android:background">@drawable/sensor_screen_button_primary</item>
        <item name="android:textColor">@color/modern_secondary_on_accent</item>
    </style>

    <style name="SensorScreenSecondaryButton" parent="SensorScreenButtonBase">
        <item name="android:background">@drawable/sensor_screen_button_secondary</item>
        <item name="android:textColor">@color/modern_secondary_text_primary</item>
    </style>

    <style name="SensorScreenDangerButton" parent="SensorScreenButtonBase">
        <item name="android:background">@drawable/sensor_screen_button_danger</item>
        <item name="android:textColor">@color/modern_secondary_danger</item>
    </style>

    <style name="SensorScreenCompactButton" parent="SensorScreenSecondaryButton">
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="SensorScreenPermissionButton" parent="SensorScreenButtonBase">
        <item name="android:background">@drawable/sensor_screen_permission</item>
        <item name="android:textColor">@color/modern_secondary_warning</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>
