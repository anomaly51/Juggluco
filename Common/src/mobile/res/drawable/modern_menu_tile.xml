<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/lifeprompt_primary_container">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/modern_secondary_surface_raised" />
            <stroke
                android:width="@dimen/lifeprompt_outline_width"
                android:color="@color/modern_secondary_border_subtle" />
            <corners android:radius="@dimen/lifeprompt_radius_md" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/lifeprompt_radius_md" />
        </shape>
    </item>
</ripple>
