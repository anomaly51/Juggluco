<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/unpairOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D0060301"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp"
        android:elevation="0dp"
        android:background="@drawable/bg_unpair_progress_panel">

        <ProgressBar
            android:id="@+id/unpairSpinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:indeterminateTint="@color/lifeprompt_primary" />

        <TextView
            android:id="@+id/unpairTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/releasingsensor" 
            android:fontFamily="monospace"
            android:textColor="@color/lifeprompt_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/unpairMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/connecttosensor" 
            android:fontFamily="monospace"
            android:textColor="@color/lifeprompt_on_surface_variant"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.15" />

        <Button
            android:id="@+id/unpairCloseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:fontFamily="monospace"
            android:textColor="@color/lifeprompt_primary"
            android:text="@string/closename" 
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
