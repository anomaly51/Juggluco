<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hori"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sensor_screen_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center_horizontal"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SensorScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sensors" />

                <TextView
                    style="@style/SensorScreenSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/sensor_screen_subtitle" />
            </LinearLayout>

            <Button
                android:id="@+id/close"
                style="@style/SensorScreenCompactButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/closename"
                android:text="@string/closename" />
        </LinearLayout>

        <TextView
            android:id="@+id/bluestate"
            style="@style/SensorScreenStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/bluetoothenabled" />

        <Button
            android:id="@+id/locationpermission"
            style="@style/SensorScreenPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/scan_permission" />

        <TextView
            android:id="@+id/scan"
            style="@style/SensorScreenLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/sensor_screen_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/SensorScreenSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sensor_screen_active_sensor" />

            <TextView
                style="@style/SensorScreenEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sensor_screen_choose_sensor" />

            <Spinner
                android:id="@+id/sensors"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/sensor_screen_field"
                android:dropDownWidth="match_parent"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <TextView
                style="@style/SensorScreenEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sensor_screen_device_address" />

            <TextView
                android:id="@+id/deviceaddress"
                style="@style/SensorScreenMonospaceValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/sensor_screen_field"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/streaming"
                    style="@style/SensorScreenValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sensornotstreamed" />

                <TextView
                    android:id="@+id/rssi"
                    style="@style/SensorScreenSignal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="RSSI" />
            </LinearLayout>

            <Button
                android:id="@+id/info"
                style="@style/SensorScreenPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/info" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/forget"
                    style="@style/SensorScreenSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/forget" />

                <Button
                    android:id="@+id/finish"
                    style="@style/SensorScreenDangerButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/finish" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/streamhistory"
                style="@style/SensorScreenSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/streamhistory" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/alarmclock"
                style="@style/SensorScreenSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/sensor_screen_alarm_clock"
                android:text="@string/alarmclock"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/resetbutton"
                    style="@style/SensorScreenSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/resetname"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/divorcebutton"
                    style="@style/SensorScreenDangerButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/divorcename"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/clear"
                    style="@style/SensorScreenDangerButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/clear"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/sensor_screen_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/SensorScreenSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sensor_screen_diagnostics" />

            <TextView
                style="@style/SensorScreenSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sensor_screen_diagnostics_hint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/sensor_screen_diagnostic_block"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView
                    style="@style/SensorScreenEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sensor_screen_started" />

                <TextView
                    android:id="@+id/stage"
                    style="@style/SensorScreenValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/stage" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/sensor_screen_diagnostic_block"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView
                    android:id="@+id/connection"
                    style="@style/SensorScreenDiagnosticTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/connection" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView2"
                            style="@style/SensorScreenEyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/last_success" />

                        <TextView
                            android:id="@+id/consuccess"
                            style="@style/SensorScreenSuccessValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView3"
                            style="@style/SensorScreenEyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/last_failure" />

                        <TextView
                            android:id="@+id/confail"
                            style="@style/SensorScreenFailureValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/textView4"
                    style="@style/SensorScreenEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/failure_info" />

                <TextView
                    android:id="@+id/constatus"
                    style="@style/SensorScreenDiagnosticBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/sensor_screen_diagnostic_block"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView
                    android:id="@+id/disconnectsensor"
                    style="@style/SensorScreenDiagnosticTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unlock_key" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SensorScreenEyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/last_success" />

                        <TextView
                            android:id="@+id/keysuccess"
                            style="@style/SensorScreenSuccessValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SensorScreenEyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/last_failure" />

                        <TextView
                            android:id="@+id/keyfailure"
                            style="@style/SensorScreenFailureValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/SensorScreenEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/failure_info" />

                <TextView
                    android:id="@+id/keyinfo"
                    style="@style/SensorScreenDiagnosticBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/sensor_screen_diagnostic_block"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView
                    style="@style/SensorScreenDiagnosticTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/glucose_value" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SensorScreenEyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/last_success" />

                        <TextView
                            android:id="@+id/glucosesuccess"
                            style="@style/SensorScreenSuccessValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SensorScreenEyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/last_failure" />

                        <TextView
                            android:id="@+id/glucosefailure"
                            style="@style/SensorScreenFailureValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/SensorScreenEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/failure_info" />

                <TextView
                    android:id="@+id/glucoseinfo"
                    style="@style/SensorScreenDiagnosticBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/sensor_screen_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/SensorScreenSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sensor_screen_connection_settings" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/usebluetooth"
                style="@style/SensorScreenSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/use_bluetooth" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/priority"
                style="@style/SensorScreenSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:contentDescription="@string/sensor_screen_high_priority"
                android:text="@string/high_priority" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/android13"
                style="@style/SensorScreenSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:contentDescription="@string/sensor_screen_android_autoconnect"
                android:text="@string/android13" />

            <Button
                android:id="@+id/background"
                style="@style/SensorScreenSecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dozemode" />
        </LinearLayout>

        <Button
            android:id="@+id/help"
            style="@style/SensorScreenSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/helpname" />
    </LinearLayout>
</ScrollView>
